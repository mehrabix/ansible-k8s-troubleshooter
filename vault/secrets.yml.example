# Example credentials file for Ansible Vault.
#
# Copy it, put your real values in, and encrypt it with YOUR OWN vault password
# — never commit the plaintext or the password:
#
#   cp vault/secrets.yml.example vault/secrets.yml
#   ansible-vault encrypt vault/secrets.yml --vault-password-file .vault_pass
#
# vault/secrets.yml and .vault_pass are gitignored. In CI/production the vault
# password comes from a secret manager or a CI secret, not from a file in the repo.
database_url: "postgres://prod:CHANGE_ME@db.prod.svc:5432/proddb"
